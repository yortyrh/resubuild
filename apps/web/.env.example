# apps/web/.env.example — local dev: `pnpm setup:env` writes apps/web/.env.
# NEXT_PUBLIC_* values are inlined at build time; changing them needs a rebuild.
# The web bundle never talks to the database or storage directly
# (enforced by apps/web/src/lib/web-bundle-security.test.ts).

# Browser → API over CORS (Bearer JSON); also serves /api/auth/* (Better Auth)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Fallback public origin of the web app where there is no browser origin (server
# rendering). In the browser, window.location.origin is always used.
NEXT_PUBLIC_APP_URL=

# Auth feature flags — mirrors of apps/api/.env (the API enforces them).
# `pnpm setup:env` / `pnpm setup:env:prod` derive these from the API values.
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_ENABLED=false
NEXT_PUBLIC_AUTH_EMAIL_VERIFICATION_ENABLED=false
NEXT_PUBLIC_AUTH_PASSWORDLESS_ENABLED=false
# OAuth buttons: on when the API has <PROVIDER>_CLIENT_ID and _CLIENT_SECRET
NEXT_PUBLIC_AUTH_GITHUB_OAUTH_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_AUTH_LINKEDIN_OAUTH_ENABLED=false

# Local dev only: Mailpit UI linked from auth screens (docker-compose.dev.yml)
NEXT_PUBLIC_DEV_MAILPIT_URL=http://127.0.0.1:54424
