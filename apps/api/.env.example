# apps/api/.env.example
#
# Local dev: `pnpm infra:up && pnpm setup:env` writes apps/api/.env for the
# Docker stack (docker-compose.dev.yml). Production: `pnpm setup:env:prod`
# (scripts/setup-prod-env.mjs) — see README "Deploy".

# ── Database ── any Postgres 15+ (Railway, DigitalOcean, AWS RDS, self-hosted)
DATABASE_URL=postgresql://resubuild:resubuild@127.0.0.1:54432/resubuild
# DATABASE_POOL_MAX=10

# ── Object storage ── any S3-compatible service (AWS S3, DigitalOcean Spaces,
# Railway Buckets, MinIO, RustFS…). Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://127.0.0.1:54490
# Host used to sign download URLs handed to clients (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:54490
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=resubuild
S3_SECRET_ACCESS_KEY=resubuild-secret
S3_FORCE_PATH_STYLE=true
MEDIA_BUCKET=media
MCP_EXPORT_BUCKET=mcp-exports
# Create both buckets at API start when missing (self-hosted storage)
# S3_AUTO_CREATE_BUCKETS=false
# MEDIA_MAX_BYTES=10485760

# ── Email ── any SMTP server (Mailpit locally). Use SMTP_URL or SMTP_HOST/…
# Hosts that block outbound SMTP (Railway Free/Hobby): set RESEND_API_KEY to
# send over the Resend HTTPS API instead (takes precedence over SMTP_*).
# RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=54425
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Resubuild <no-reply@resubuild.local>
# APP_NAME=Resubuild

# ── Server ──
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Default web origin for email links and OAuth redirects (defaults to APP_URL);
# the origin the user came from is used instead when it is WEB_URL or in CORS_ORIGIN
WEB_URL=http://localhost:3000
# Absolute base URL clients use when embedding images (Markdown `src`)
PUBLIC_API_URL=http://localhost:3001

# ── Auth (Better Auth) ── sessions live in Postgres; clients send Bearer tokens.
# Public API base for auth callbacks (defaults to PUBLIC_API_URL)
BETTER_AUTH_URL=http://localhost:3001
# ≥32 random characters (`pnpm setup:env` generates one). Rotating signs everyone out.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Feature flags (apps/web/.env mirrors them as NEXT_PUBLIC_AUTH_*)
AUTH_FORGOT_PASSWORD_ENABLED=false
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_PASSWORDLESS_ENABLED=false
# OAuth providers — enabled when both values are set.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/<github|google|linkedin>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── PDF export (Chromium) ──
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# ── MCP server ──
# HMAC pepper for MCP API keys (required). Changing it invalidates existing keys.
MCP_KEY_PEPPER=change-me-to-a-long-random-secret
# MCP_SERVER_ENABLED=true   # false → /mcp returns 404
# MCP_EXPORT_TTL_SECONDS=3600
# MCP_EXPORT_MAX_BYTES=10485760

# ── PDF import + per-user AI agent credentials ──
AI_AGENT_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Legacy alias still supported:
# IMPORT_LLM_CONFIG_ENCRYPTION_KEY=
# PDF_IMPORT_MAX_BYTES=5242880
# PDF_IMPORT_ENABLED=true
# Set to `static` to use the bundled catalog.json only (tests, offline).
# IMPORT_MODELS_CATALOG_SOURCE=

# ── Web search / page extraction (optional, shared by all users) ──
# Every provider with a key joins a round-robin rotation, so spend is spread
# across accounts; a provider that errors or runs out of credit hands over to
# the next one and is skipped for 10 minutes. Search: Brave, Tavily, Firecrawl.
# URL-import page extraction: Firecrawl, Tavily (raw HTML fetch without them).
# FIRECRAWL_API_KEY also raises the limits of anydoc's hosted OCR for scanned
# PDFs (keyless otherwise).
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# BRAVE_SEARCH_API_KEY=

# ── Included AI (optional, app-funded models for signed-in users) ──
# Users without their own API key (or who pick "Resubuild included AI") run AI
# features on these models. JSON array; each entry has a stable id (keys the
# usage counters), a Mastra model id, the deployment's API key, a monthly token
# budget, and optional model options (same keys as the AI settings, e.g.
# reasoningEffort). Entries rotate round-robin; one that used its budget or is
# rejected/rate-limited by the provider is skipped. Budgets reset every UTC month.
# AI_INCLUDED_MODELS=[{"id":"openai-1","model":"openai/gpt-5-mini","apiKey":"sk-...","monthlyTokenLimit":20000000,"options":{"reasoningEffort":"low"}}]
# Monthly tokens each user may spend on included models (0/unset = included AI off).
# AI_INCLUDED_USER_MONTHLY_TOKEN_LIMIT=200000

# ── Free import wizard (optional, app-funded models for visitors) ──
# Visitors can import a CV before signing up; the preview is saved once they
# create an account. Same JSON format as AI_INCLUDED_MODELS. When every entry
# used its monthly budget the wizard switches itself off (regular sign-up
# stays open).
# AI_GUEST_MODELS=[{"id":"guest-openai","model":"openai/gpt-5-mini","apiKey":"sk-...","monthlyTokenLimit":5000000}]
# AI_GUEST_IMPORT_ENABLED=true
# Free imports per visitor IP per UTC day (0 = unlimited). Default 3.
# AI_GUEST_IMPORTS_PER_IP_PER_DAY=3
# Cloudflare Turnstile challenge for the wizard (set both, or neither).
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Behind a reverse proxy, trust X-Forwarded-For so per-IP limits see the
# visitor's address: true, a hop count (e.g. 1), or addresses/subnets.
# TRUST_PROXY=1
