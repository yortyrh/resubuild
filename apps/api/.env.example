# apps/api/.env.example
#
# Local dev: `pnpm infra:up && pnpm setup:env` writes apps/api/.env for the
# Docker stack (docker-compose.dev.yml). Production: `pnpm setup:env:prod`
# (scripts/setup-prod-env.mjs) — see README "Deploy".

# ── Database ── any Postgres 15+ (Railway, DigitalOcean, AWS RDS, self-hosted)
DATABASE_URL=postgresql://resubuild:resubuild@127.0.0.1:54432/resubuild
# DATABASE_POOL_MAX=10

# ── Object storage ── any S3-compatible service (AWS S3, DigitalOcean Spaces,
# Railway Buckets, MinIO, RustFS…). Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://127.0.0.1:54490
# Host used to sign download URLs handed to clients (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:54490
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=resubuild
S3_SECRET_ACCESS_KEY=resubuild-secret
S3_FORCE_PATH_STYLE=true
MEDIA_BUCKET=media
MCP_EXPORT_BUCKET=mcp-exports
# Create both buckets at API start when missing (self-hosted storage)
# S3_AUTO_CREATE_BUCKETS=false
# MEDIA_MAX_BYTES=10485760

# ── Email ── any SMTP server (Mailpit locally). Use SMTP_URL or SMTP_HOST/…
SMTP_HOST=127.0.0.1
SMTP_PORT=54425
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Resubuild <no-reply@resubuild.local>
# APP_NAME=Resubuild

# ── Server ──
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Web origin used in email links and OAuth redirects (defaults to APP_URL)
WEB_URL=http://localhost:3000
# Absolute base URL clients use when embedding images (Markdown `src`)
PUBLIC_API_URL=http://localhost:3001

# ── Auth (Better Auth) ── sessions live in Postgres; clients send Bearer tokens.
# Public API base for auth callbacks (defaults to PUBLIC_API_URL)
BETTER_AUTH_URL=http://localhost:3001
# ≥32 random characters (`pnpm setup:env` generates one). Rotating signs everyone out.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Feature flags (apps/web/.env mirrors them as NEXT_PUBLIC_AUTH_*)
AUTH_FORGOT_PASSWORD_ENABLED=false
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_PASSWORDLESS_ENABLED=false
# OAuth providers — enabled when both values are set.
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/<github|google|linkedin>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── PDF export (Chromium) ──
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# ── MCP server ──
# HMAC pepper for MCP API keys (required). Changing it invalidates existing keys.
MCP_KEY_PEPPER=change-me-to-a-long-random-secret
# MCP_SERVER_ENABLED=true   # false → /mcp returns 404
# MCP_EXPORT_TTL_SECONDS=3600
# MCP_EXPORT_MAX_BYTES=10485760

# ── PDF import + per-user AI agent credentials ──
AI_AGENT_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Legacy alias still supported:
# IMPORT_LLM_CONFIG_ENCRYPTION_KEY=
# PDF_IMPORT_MAX_BYTES=5242880
# PDF_IMPORT_ENABLED=true
# Set to `static` to use the bundled catalog.json only (tests, offline).
# IMPORT_MODELS_CATALOG_SOURCE=
