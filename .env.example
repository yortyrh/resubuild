# Root .env — not used by the apps. Each app reads its own env file:
#
#   apps/api/.env   (see apps/api/.env.example)
#   apps/web/.env   (see apps/web/.env.example)
#
# Local dev workflow:
#   1. pnpm infra:up     # Postgres, S3 storage (RustFS) and Mailpit in Docker
#   2. pnpm setup:env    # writes apps/api/.env and apps/web/.env
#   3. pnpm samples:seed # sample accounts, CVs and media
#   4. pnpm dev
#
# Every email the API sends is captured by Mailpit: http://127.0.0.1:54424
#
# Infra host ports can be changed before `pnpm infra:up` / `pnpm setup:env`:
# RESUBUILD_POSTGRES_PORT=54432
# RESUBUILD_S3_PORT=54490
# RESUBUILD_S3_CONSOLE_PORT=54491
# RESUBUILD_SMTP_PORT=54425
# RESUBUILD_MAILPIT_PORT=54424
